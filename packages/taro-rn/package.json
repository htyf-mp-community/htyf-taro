{
  "name": "@htyf-mp/taro-rn",
  "version": "0.7.9",
  "description": "Taro RN framework",
  "author": "O2Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "src",
    "types",
    "apiList.js",
    "libList.js"
  ],
  "scripts": {
    "prod": "pnpm run build",
    "assets": "cpy 'src/**/*.png' '!src/__tests__/*' dist",
    "clean": "rimraf ./dist apiList.js libList.js",
    "build": "pnpm run clean && pnpm run script && tsc && pnpm run assets",
    "dev": "pnpm run assets && tsc --watch",
    "lint": "eslint src script __tests__ --ext .js,.jsx.ts,.tsx",
    "test": "jest --silent --runInBand --watchman=false",
    "test:ci": "jest --ci -i --coverage --silent",
    "test:coverage": "jest --coverage",
    "test:dev": "jest --watch",
    "script": "node ./script"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/htyf-mp-community/htyf-taro.git",
    "directory": "packages/taro-rn"
  },
  "keywords": [
    "taro"
  ],
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@htyf-mp/taro-runtime-rn": "workspace:*",
    "@tarojs/taro": "4.2.1",
    "base64-js": "1.5.1"
