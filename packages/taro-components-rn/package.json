{
  "name": "@htyf-mp/taro-components-rn",
  "version": "0.7.9",
  "description": "React Native 基础组件",
  "author": "O2Team",
  "license": "MIT",
  "main": "./dist/index.js",
  "scripts": {
    "prod": "pnpm run build",
    "assets": "cpy 'src/**/*.png' '!src/__tests__/*' dist",
    "clean": "rimraf ./dist",
    "build": "pnpm run clean && tsc && pnpm run assets",
    "dev": "pnpm run assets && tsc --watch",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "test": "jest --silent --runInBand --watchman=false",
    "test:ci": "jest --ci -i --coverage --silent",
    "test:dev": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "!dist/**/__tests__/**",
    "!dist/setup.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/htyf-mp-community/htyf-taro.git",
    "directory": "packages/taro-components-rn"
  },
  "keywords": [
    "taro"
  ],
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@ant-design/react-native": "5.4.3",
    "@htyf-mp/taro-router-rn": "workspace:*",
    "@tarojs/components": "4.2.0",
    "prop-types": "15.8.1",
    "react-native-maps": "1.29.11"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-env": "7.29.7",
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-native/babel-preset": "0.88.1",
    "@testing-library/jest-native": "5.4.2",
    "@testing-library/react-native": "12.4.1",
    "@types/react": "19.3.0",
    "cpy-cli": "5.0.0",
    "dpdm": "3.14.0",
    "expo": "58.0.21",
    "expo-camera": "58.0.14",
    "expo-video": "58.0.13",
    "jest-expo": "58.0.13",
    "react-native": "0.88.1",
    "react-native-pager-view": "9.0.7",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "peerDependencies": {
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "expo": "58.0.21",
    "expo-camera": "58.0.14",
    "expo-video": "58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-pager-view": "9.0.7",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/index.d.ts"
}
